# Database
POSTGRES_USER=son
POSTGRES_PASSWORD=son
POSTGRES_DB=son
DATABASE_URL=postgresql+psycopg://son:son@postgres:5432/son

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# API
SON_USER_AGENT=SnowObservationsNetwork/0.1 (+https://github.com/jasonflaherty/Snow-Observations-Network)
ANON_RATE_LIMIT_PER_DAY=1000
SON_FREE_KEY=change-me-free
SON_RESEARCH_KEY=change-me-research
SON_PRO_KEY=change-me-pro

# Storage
RAW_STORAGE_PATH=/data/raw

# Production (docker-compose.prod.yml / NixiHost VPS)
# SON_DOMAIN=api.yourdomain.com
# SON_IMAGE=son:prod

# Browser CORS (comma-separated). Needed for GitHub Pages explorer.
# CORS_ORIGINS=https://jasonflaherty.github.io,http://localhost:8080
